{
  "name": "pebble-tandoor",
  "author": "Sylonin",
  "version": "1.0.0",
  "description": "Browse your Tandoor recipes on a Pebble Time 2 and cook them step by step, with timers that ring on the watch.",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "scripts": {
    "test": "node --test test/*.test.cjs"
  },
  "pebble": {
    "displayName": "Tandoor",
    "uuid": "261a265f-72a5-40a7-911d-1809026156c0",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery"
    ],
    "watchapp": {
      "watchface": false
    },
    "configPage": "src/config.html",
    "usesPermissions": [
      {
        "name": "Internet",
        "reason": "To read recipes from your Tandoor server, which can be at any address",
        "required": true
      },
      {
        "name": "LocalNetwork",
        "reason": "To reach a Tandoor server on your home network",
        "required": false
      }
    ],
    "messageKeys": [
      "Cmd",
      "Req",
      "Kind",
      "Id",
      "Page",
      "Query",
      "State",
      "Text",
      "Data",
      "Index",
      "More",
      "Total",
      "Done",
      "Name",
      "Desc",
      "Servings",
      "ServText",
      "Time1",
      "Time2",
      "Rating",
      "Count",
      "Sub",
      "Flags",
      "Backlight",
      "Sound"
    ],
    "resources": {
      "media": [
